RELAY_DOMAIN=relay.example.com
HOST_DEVICE_PUBLIC_KEYS=DEVICE_KEY_ID:BASE64URL_P256_SPKI
SESSION_TTL_MS=21600000
MAX_SESSIONS=20
MAX_SESSIONS_PER_HOST_DEVICE=3
MAX_CONNECTIONS=100
MAX_CONNECTIONS_PER_IP=20
MAX_UPGRADES_PER_IP_PER_MINUTE=60
MAX_NEW_SESSIONS_PER_IP_PER_MINUTE=5
MAX_HTTP_PER_IP_PER_MINUTE=300
MAX_APPROVAL_REQUESTS_PER_MINUTE=5
MAX_WS_BUFFERED_BYTES=1048576
COMPOSE_PROFILES=tunnel
CLOUDFLARED_CREDENTIALS_FILE=C:/Users/you/.cloudflared/TUNNEL_ID.json
